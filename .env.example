# AI 웹진 자동화 시스템 환경 변수 템플릿
# 이 파일을 복사하여 .env로 저장하고 실제 값을 입력하세요
# .env는 절대 git에 커밋하지 마세요

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Tavily Search API (https://app.tavily.com)
TAVILY_API_KEY=tvly-...

# Gmail API OAuth2 (https://console.cloud.google.com)
GMAIL_CLIENT_ID=...apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REFRESH_TOKEN=1//...
GMAIL_SENDER_ADDRESS=your-email@gmail.com

# Claude Code Routines (Routine C API 트리거)
ROUTINE_C_ENDPOINT=https://api.anthropic.com/v1/...
ROUTINE_C_BEARER_TOKEN=sk-ant-...

# FastAPI 세션 암호화 키 (랜덤 32바이트 hex)
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=

# GitHub (PyGitHub 저장소 읽기/쓰기)
# Personal Access Token: repo 권한 필요
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-username/ai-webzine

# 선택: 관리자 이메일 (알림 수신)
ADMIN_EMAIL=admin@company.com
